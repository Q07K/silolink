{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiloLink",
  "version": "0.3.0",
  "identifier": "io.silolink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-installer.ps1"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SiloLink", "width": 1320, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/silolink.exe": "bin/silolink.exe" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Connect your AI work, knowledge, and projects",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["Korean", "English"]
      }
    }
  }
}
